/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. 
 */

params {

	input				= "data/fastq_pass/"
	output				= "data/reference_based/cpu"
        reference			= "data/ref/lpa-ref5104.fasta"
        reference_fai			= "data/ref/lpa-ref5104.fasta.fai"
        bed				= "data/ref/lpa-ref5104.bed"

	
	clusters_poer_polishing_file	= 50
	max_reads_per_cluster		= 50
	chunk_size			= 50000
        min_read_length			= 4500
        min_qscore			= 13
	vsearch_sequence_identity	= 0.95
        min_overlap			= 0.95
        umi_errors			= 3
	live				= false
	use_gpu				= false
	reference_based_polishing	= true
	include_secondary_reads		= false
	balance_strands			= false
	adapter_length			= 250
	umi_errors			= 3
	fwd_umi				= "TTTVVVVTTVVVVTTVVVVTTVVVVTTT"
	rev_umi				= "AAABBBBAABBBBAABBBBAABBBBAAA"
	fwd_context			= "GTATCGTGTAGAGACTGCGTAGG"
	rev_context			= "CACTCGCACTGACTCGATCACT"

	output_format			= "fastq"	
	filter_strategy_clusters	= "quality"
	balance_strands			= false
	max_dist_umi			= 1
	min_reads_per_cluster		= 6

	medaka_model			= "r1041_e82_400bps_sup_v4.3.0"

	min_consensus_quality		= 45
	masking_strategy		= "softmask"

	call_variants			= true
	variant_caller			= "mutserve"
}

// NEXTFLOW REPORTING
if(params.output != null){
	dag {
		enabled = true
		file = "${params.output}/nextflow_stats/dag.mmd"
		overwrite = true
	}
	report {
		enabled = true
		file = "${params.output}/nextflow_stats/report.html"
		overwrite = true
	}
	timeline {
		enabled = true
		file = "${params.output}/nextflow_stats/timeline.html"
		overwrite = true
	}
	trace {
		enabled = true
		file = "${params.output}/nextflow_stats/trace.txt"
		overwrite = true
	}
}
